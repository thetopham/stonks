[Unit]
Description=Stonks Paper Bot autonomous paper-trading loop
Documentation=file:/home/matt/workspace/stonks-paper-bot/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/matt/workspace/stonks-paper-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/matt/workspace/stonks-paper-bot/.venv/bin/stonks-paper watch --config /home/matt/workspace/stonks-paper-bot/config.paper.toml
Restart=always
RestartSec=30

[Install]
WantedBy=default.target

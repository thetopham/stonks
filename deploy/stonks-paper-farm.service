[Unit]
Description=Stonks Paper Bot local-only strategy farm scheduler
Documentation=file:/home/matt/workspace/stonks-paper-bot/docs/strategy-farm.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/matt/workspace/stonks-paper-bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/matt/workspace/stonks-paper-bot/.venv/bin/stonks-paper farm-watch --farm-dir /home/matt/workspace/stonks-paper-bot/configs/farm --poll-seconds 30
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
